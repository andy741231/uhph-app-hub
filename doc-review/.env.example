APP_NAME="Document Reviewer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000/apps/doc-review

# Path prefix where built assets are served (the app mount + /build).
# Required so Vite-emitted URLs (e.g. the PDF.js worker .mjs) resolve
# correctly when the app is mounted at /apps/doc-review instead of /.
ASSET_URL=/apps/doc-review

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local default is a dedicated SQLite file. Production uses its own
# database/schema — never share the legacy Hub or another app's database.
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=doc_review
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=uhph_doc_review_session
SESSION_PATH=/apps/doc-review
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# UHPH App Hub single sign-on. The app fails closed (503 on /login) until
# credentials are configured; enable only after the Hub issues them.
HUB_SSO_ENABLED=false
HUB_URL=http://localhost:8000/apps
HUB_CLIENT_ID=
HUB_CLIENT_SECRET=
HUB_CALLBACK_URI=/apps/doc-review/auth/hub/callback
HUB_VERIFY_TLS=true
HUB_SESSION_REVALIDATION_MINUTES=15
