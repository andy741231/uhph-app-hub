<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>

        <!-- Default document: Laravel's front controller -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <!-- Directory browsing off (security) -->
        <directoryBrowse enabled="false" />

        <rewrite>
            <rules>
                <!-- Send all non-file requests to index.php.

                     Do NOT check IsDirectory — checking it prevents "/" from
                     being rewritten (because "/" maps to public/, which IS a
                     directory). IIS then falls back to Default Document, which
                     returns 405 on some configurations. By only checking
                     IsFile, "/" is properly rewritten to index.php by URL
                     Rewrite. Real files (CSS, JS, images) are still served
                     directly. -->
                <rule name="Laravel Front Controller" stopProcessing="true">
                    <match url="^" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>



        <!-- Hide sensitive files (defense in depth) -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".git" />
                    <add segment=".env" />
                    <add segment="vendor" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <!-- Static file caching -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>

    </system.webServer>
</configuration>
